# Copy to .env for local development. Never commit .env.
ORGNISER_ENVIRONMENT=local
ORGNISER_DEBUG=true
ORGNISER_DATABASE_URL=postgresql+psycopg://orgniser:orgniser@localhost:5433/orgniser
ORGNISER_REDIS_URL=redis://localhost:6379/0
ORGNISER_CORS_ORIGINS=["http://localhost:3000"]
ORGNISER_FRONTEND_BASE_URL=http://localhost:3000
# Providers: leave empty to use the local stand-ins (docs/PROTOTYPE.md).
ORGNISER_STORAGE_PROVIDER=
ORGNISER_EMAIL_PROVIDER=
